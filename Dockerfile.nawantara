FROM node:22-alpine3.20 AS frontend
WORKDIR /app
ENV CYPRESS_INSTALL_BINARY=0 NODE_OPTIONS=--max-old-space-size=6144
COPY package.json package-lock.json ./
RUN npm ci --force
COPY src ./src
COPY static ./static
COPY scripts ./scripts
COPY crypto ./crypto
COPY svelte.config.js vite.config.ts tailwind.config.js postcss.config.js tsconfig.json ./
RUN npm run crypto:verify && npx vite build

FROM ghcr.io/open-webui/open-webui:v0.12.3@sha256:a537bbe1e6b428820f52ed4a029d7fff97062e24d5cf32c365fba36fd0542def
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng tesseract-ocr-ind poppler-utils && rm -rf /var/lib/apt/lists/*
RUN rm -rf /app/build/_app
COPY --from=frontend /app/build /app/build
COPY backend/open_webui /app/backend/open_webui
COPY backend/nawantara_nextcloud /app/backend/nawantara_nextcloud
ENV WEBUI_NAME=Nawantara
# The deployment uses the local GGUF service; do not seed new volumes with MiniLM weights.
RUN rm -rf /app/backend/data/cache/embedding/models/models--sentence-transformers--all-MiniLM-L6-v2 /app/backend/data/cache/embedding/models/.locks/models--sentence-transformers--all-MiniLM-L6-v2
ENV RAG_EMBEDDING_ENGINE=openai RAG_EMBEDDING_MODEL=embeddinggemma-2-Q8_0 RAG_OPENAI_API_BASE_URL=http://embedding:8080/v1
